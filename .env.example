# Resend (https://resend.com) — the sending domain must be verified in Resend.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM="Another Level <porosi@radari.site>"
# Inbox that receives new orders (comma-separated for several).
ORDER_TO_EMAIL=orders@example.com

# Public URL used for canonical / hreflang / sitemap. Optional on Railway:
# RAILWAY_PUBLIC_DOMAIN is used automatically when SITE_URL is empty.
SITE_URL=

# Extra origins allowed to POST /api/order (only needed if the frontend is hosted elsewhere).
ALLOWED_ORIGINS=

NODE_ENV=production
PORT=3000
